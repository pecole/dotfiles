# CLIツール (Mac / Linux 共通)
brew "automake"
brew "bat"
brew "bison"
brew "bitwarden-cli"
brew "deno" # zeno.zshが使用
brew "fd"
brew "gawk"
brew "gh"
brew "ghq"
brew "git"
brew "gnupg"
brew "graphviz"
brew "imagemagick"
brew "jq"
brew "lazygit"
brew "libsodium"
brew "lv"
brew "neovim"
brew "pkgconf"
brew "pwgen"
brew "ripgrep"
brew "rustup"
brew "sheldon"
brew "starship"
brew "tmux"
brew "tree"
brew "tree-sitter-cli" # neovimのtreesitterパーサービルド用
brew "watch"
brew "wget"

# Macのみ
if OS.mac?
  tap "beeftornado/rmtree"
  brew "beeftornado/rmtree/brew-rmtree"

  tap "qmu/mcc"
  brew "qmu/mcc/mcc" # ターミナルダッシュボード (darwin向けバイナリのみ配布)

  brew "pngpaste" # クリップボードのPNGをファイル化 (macOS専用)

  cask "balenaetcher"
  cask "brave-browser"
  cask "claude"
  cask "claude-code"
  cask "cyberduck"
  cask "deepl"
  cask "docker-desktop" # 旧: docker
  cask "gcloud-cli" # 旧: google-cloud-sdk
  cask "google-chrome"
  cask "karabiner-elements"
  cask "local"
  cask "raycast"
  cask "wezterm"
end
