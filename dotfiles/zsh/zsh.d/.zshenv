# =============================================================================
# .zshenv (ZDOTDIR配下) — zsh を起動するたびに必ず読み込まれる設定
#
# 「対話シェル (人が操作するターミナル)」だけでなく、スクリプトから zsh を
# 呼んだときにも読み込まれる。そのため、ここには環境変数のように
# どんな場面でも必要なものだけを書く。
# 見た目やキー割り当てなど対話中だけ必要なものは .zshrc に書く。
# =============================================================================


# -----------------------------------------------------------------------------
# PATH に同じディレクトリを重複して入れない
#
# path は PATH と連動した配列。-U を付けると、同じ値を追加しても
# 1つしか保持しなくなる。
# zsh は入れ子に起動できるので、これが無いと下の $HOME/bin のような追記が
# 起動のたびに積み重なってしまう。
# -----------------------------------------------------------------------------
typeset -U path fpath manpath

# 自作スクリプトの置き場所を PATH の最後に足す
path=($path $HOME/bin)


# -----------------------------------------------------------------------------
# 各種の既定値
# -----------------------------------------------------------------------------
export LANG=ja_JP.UTF-8   # 文字コードと言語
export EDITOR='nvim'      # git commit などで開かれるエディタ
export PAGER=less         # man などで長い出力を表示するときに使うツール

# less の表示オプション
#   -g 検索結果は最後の一致だけ強調   -i 小文字入力は大文字小文字を区別しない
#   -M 詳細なステータス行を出す        -R 色をそのまま表示する
#   -S 長い行を折り返さない            -W 移動後の新しい行を強調する
#   -z-4 1画面ぶんより4行少なくスクロール  -x4 タブ幅を4にする
export LESS='-g -i -M -R -S -W -z-4 -x4'

# zeno (入力補助プラグイン) の設定ファイルの場所
export ZENO_HOME=~/.config/zeno

# macOS はターミナルのセッションを ZDOTDIR に記録しようとする。
# dotfiles のディレクトリが汚れるので止めておく
export SHELL_SESSIONS_DISABLE=1
