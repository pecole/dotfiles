# =============================================================================
# ~/.zshenv — zsh が最初に読み込むファイル
#
# zsh の設定は散らかりやすいので、実体は ~/.zsh.d/ にまとめている。
# このファイルの役目は「設定の置き場所を zsh に教えること」だけ。
#
# 読み込まれる順番:
#   このファイル → ~/.zsh.d/.zshenv → (対話シェルなら) ~/.zsh.d/.zshrc
# =============================================================================

# 起動時間の計測用。遅くなった原因を調べたいときはこの行のコメントを外す
# (結果は .zshrc の最後で表示される)
# zmodload zsh/zprof

# 設定の置き場所が無ければ、以降の処理は何もしない
[ -d ${HOME}/.zsh.d ] || return

# zsh に「設定はここにある」と教える
export ZDOTDIR=${HOME}/.zsh.d

# 常に必要な設定を読み込む
[ -r ${ZDOTDIR}/.zshenv ] && . ${ZDOTDIR}/.zshenv

# このマシンだけの設定 (APIキーなど) があれば読み込む。
# git で管理していないので、公開したくない値はここに書く
[ -r ${HOME}/.zsh_local ] && . ${HOME}/.zsh_local
